# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# OBRIGATÓRIO para a API Fastify (server/): JWT secret do projeto Supabase
# (Project Settings > API > JWT Secret). Sem ele a API não sobe.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Database (Supabase Postgres direct connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# OpenAI (para geração de treinos com IA)
OPENAI_API_KEY=your_openai_api_key_here

# Fastify Server
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Redis (para BullMQ - Sessão 4)
REDIS_URL=redis://localhost:6379
