{
  "expo": {
    "name": "FisioMentor",
    "slug": "fisiomentor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#061423"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.fisiomentor.app",
      "supportsTabletMode": true,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.fisiomentor.app",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061423"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fisiomentor",
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
